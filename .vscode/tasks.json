{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "npm",
      "script": "dev",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Diagnose (check everything)",
      "type": "npm",
      "script": "diagnose",
      "dependsOn": [
        "Typecheck",
        "Lint",
        "Format Check",
        "Docs Check",
        "Comments Check",
        "CSS Check",
        "Unit Tests"
      ],
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Format Check",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": []
    },
    {
      "label": "Unit Tests",
      "type": "npm",
      "script": "test",
      "group": "test",
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "E2E Tests",
      "type": "npm",
      "script": "test:e2e",
      "group": "test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docs Check",
      "type": "npm",
      "script": "docs:check",
      "problemMatcher": []
    },
    {
      "label": "Comments Check",
      "type": "npm",
      "script": "comments:check",
      "problemMatcher": []
    },
    {
      "label": "CSS Check",
      "type": "npm",
      "script": "css:check",
      "problemMatcher": []
    },
    {
      "label": "Audit (npm)",
      "type": "npm",
      "script": "audit",
      "problemMatcher": []
    }
  ]
}
