# push-sec: block direct/forced pushes to protected branches (Git Flow).
# main + develop are protected: code reaches them only via PR merges
# (and main additionally from release/hotfix merges). Force pushes are
# blocked everywhere. Safe, single-owner escape hatch: ALLOW_PROTECTED_PUSH=1.
if [ "$ALLOW_PROTECTED_PUSH" = "1" ]; then
  exit 0
fi
protected="refs/heads/main refs/heads/develop"
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_ref" = "+${local_ref#+}" ]; then
    echo "push-sec: force push blocked ($local_ref). Protected branches never allow force." >&2
    exit 1
  fi
  case " $protected " in
    *" $remote_ref "*)
      echo "push-sec: direct push to $remote_ref blocked. Open a pull request; $remote_ref only receives PR/release merges." >&2
      exit 1
      ;;
  esac
done