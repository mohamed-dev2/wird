# Next.js build outputs and cache
.next/

# NPM cache files
.npm-cache/

# Installed project dependencies
node_modules/

# Local outputs and work folders
outputs/
work/

# TypeScript incremental build info
tsconfig.tsbuildinfo

# Next.js generated env types (regenerated on dev/build, churns paths)
next-env.d.ts

# Logs and OS artifacts
*.log
npm-debug.log*
.DS_Store

# Test artifacts
test-results/
playwright-report/

# Vercel
.vercel/

# Local environment secrets — never commit real .env files.
# Only the documented .env.example is tracked.
.env
.env.*
!.env.example
